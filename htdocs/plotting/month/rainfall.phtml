<?php
$OL = "10.10.0";
require_once "../../../config/settings.inc.php";
require_once "../../../include/myview.php";
require_once "../../../include/database.inc.php";
require_once "../../../include/forms.php";
$t = new MyView();
$t->iemselect2 = TRUE;

$station = isset($_GET['station']) ? xssafe($_GET["station"]) : "";
$network = isset($_GET["network"]) ? xssafe($_GET['network']) : "IA_ASOS";
$year = get_int404('year', date("Y"));
$month = get_int404('month', date("m"));

$t->headextra = <<<EOM
<link rel="stylesheet" href="/vendor/openlayers/{$OL}/ol.css" type="text/css">
<link type="text/css" href="/vendor/openlayers/{$OL}/ol-layerswitcher.css" rel="stylesheet" />
<link type="text/css" href="rainfall.css" rel="stylesheet" />
EOM;
$t->jsextra = <<<EOM
<script src="/vendor/openlayers/{$OL}/ol.js" type="text/javascript"></script>
<script src='/vendor/openlayers/{$OL}/ol-layerswitcher.js'></script>
<script src="/js/olselect.js"></script>
EOM;

$t->title = "Monthly Rainfall Traces";
$addSelectAttributes = fn($select, $id) => str_replace(
    "<select ",
    "<select id=\"{$id}\" ",
    str_replace('class="iemselect2"', 'class="form-select iemselect2"', $select),
);

$content = <<<EOM
<nav aria-label="breadcrumb">
<ol class="breadcrumb mb-3">
<li class="breadcrumb-item"><a href="/plotting/">Plotting</a></li>
<li class="breadcrumb-item active" aria-current="page">Monthly Rainfall Traces</li>
</ol>
</nav>

<header class="mb-4">
<h1 class="h3">Monthly Rainfall Traces</h1>

<p>This application creates a plot of observed precipitation versus
climatology for a site of your choice in Iowa.</p>
</header>
EOM;
if (strlen($station) > 0) {
    $nselect = networkSelect($network, $station, array(), "station", FALSE, "form-select");
    $nselect = $addSelectAttributes($nselect, "station");
    $yselect = $addSelectAttributes(yearSelect(2004, $year, "year"), "year");
    $mselect = $addSelectAttributes(monthSelect($month), "month");
    $content .= <<<EOM
<form name="ds" action="rainfall.phtml" method="GET" class="card shadow-sm mb-4">
<div class="card-body">
<input type="hidden" value="{$network}" name="network">
<div class="row g-3 align-items-end">
<div class="col-lg-5">
<label for="station" class="form-label">Site</label>
{$nselect}
<div class="form-text"><a href="rainfall.phtml?network={$network}">Select from map</a></div>
</div>
<div class="col-sm-6 col-lg-3">
<label for="year" class="form-label">Year</label>
{$yselect}
</div>
<div class="col-sm-6 col-lg-2">
<label for="month" class="form-label">Month</label>
{$mselect}
</div>
<div class="col-lg-2">
<button type="submit" class="btn btn-primary w-100">Make plot</button>
</div>
</div>
</div>
</form>

<section aria-labelledby="plot-heading">
<h2 id="plot-heading" class="h5">Monthly precipitation</h2>
<img src="/plotting/auto/plot/17/month:{$month}::year:{$year}::station:{$station}::network:{$network}::p:precip.png" alt="Monthly rainfall trace for site {$station}" class="img-fluid" />
</section>
EOM;
} else {
    $nselect = networkSelect($network, "", array(), "station", FALSE, "form-select");
    $nselect = $addSelectAttributes($nselect, "station");
    $content .= <<<EOM
<div class="mb-4">
<div class="btn-group flex-wrap" role="group" aria-label="Rainfall network selection">
<a class="btn btn-outline-primary" href="rainfall.phtml?network=IA_ASOS">Iowa ASOS</a>
<a class="btn btn-outline-primary" href="rainfall.phtml?network=IA_COOP">Iowa NWS COOP</a>
</div>
</div>

<form name="olselect" action="rainfall.phtml" method="GET">
<input type="hidden" value="{$network}" name="network">
<div class="row g-4">
<div class="col-lg-5">
<section class="card" aria-labelledby="station-heading">
<div class="card-header"><h2 id="station-heading" class="h5 mb-0">Select station</h2></div>
<div class="card-body">
<label for="station" class="form-label">Site</label>
{$nselect}
<button type="submit" class="btn btn-primary mt-3">Make plot</button>
</div>
</section>
</div>
<div class="col-lg-7">
<section class="card" aria-labelledby="map-heading">
<div class="card-header"><h2 id="map-heading" class="h5 mb-0">Select from map</h2></div>
<div class="card-body"><div id="map" data-network="{$network}" class="border rounded" style="min-height: 24rem;"></div></div>
</section>
</div>
</div>
</form>
EOM;
}
$t->content = $content;
$t->render('single.phtml');
