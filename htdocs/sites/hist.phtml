<?php
require_once "../../config/settings.inc.php";
define("THROTTLE_APP", "sites/obhistory");
define("THROTTLE_LIMIT", 32);
define("TEMPLATE", "sites.phtml");
// sites calls throttle
require_once "../../include/sites.php";
require_once "../../include/forms.php";
require_once "../../include/myview.php";

$ctx = get_sites_context();
$station = $ctx->station;
$network = $ctx->network;
$metadata = $ctx->metadata;

$t = new MyView();
$t->sites_current = "calendar";

if ((($metadata["metasite"] ?? null) === "t") && (strpos($network, "CLIMATE") === false)
    && (strpos($network, "COCORAHS") === false)) {
    $t->content = "<p>This site does not have observations.</p>";
    $t->render(TEMPLATE);
    exit();
}

$t->iemselect2 = true;

/* Get vars */
$dt = dt_from_cgi_ymd();
$mode = get_str404('mode', 'monthly');

// Don't allow dates into the future
if ($dt->format("Y") > gmdate("Y")) {
    $dt = new DateTimeImmutable(gmdate("Y-m-d"));
}
$day = intval($dt->format("d"));
$month = intval($dt->format("m"));
$year = intval($dt->format("Y"));

$nicedate = $dt->format("d M Y");
$nicemonthdate = $dt->format("M Y");

$t->title = $mode == "monthly"
    ? sprintf("%s Data Calendar for %s", $station, $nicemonthdate)
    : sprintf("%s Network Summary for %s", $network, $nicedate);
$mountpoint = sprintf(
    '<div id="hist-app" role="status" aria-live="polite" data-mode="%s" data-network="%s" data-station="%s" data-year="%s" data-month="%s" data-day="%s">Loading data...</div>',
    htmlspecialchars($mode, ENT_QUOTES, 'UTF-8'),
    htmlspecialchars($network, ENT_QUOTES, 'UTF-8'),
    htmlspecialchars($station, ENT_QUOTES, 'UTF-8'),
    $year,
    $month,
    $day
);

$content = <<<EOM
<div class="hidden-print">
<form method="GET" name="changer" class="form-inline" role="form">
<input type="hidden" name="station" value="{$station}">
<input type="hidden" name="network" value="{$network}">
EOM;
$startyear = 2002;
if (!is_null($metadata["archive_begin"])) {
    $startyear = $metadata["archive_begin"]->format("Y");
}
$ys = yearSelect($startyear, $year, "year");
$ms = monthSelect($month, "month");
$ds = daySelect($day);
if ($mode == "monthly") {
    $content .= <<<EOM
<h2>Data Calendar for {$metadata["name"]}</h2>
<p>The calendar chart below shows the daily reported climate variables.
You can click on a date to display the values for all sites for that day.
Time stamps are displayed in the <strong>{$metadata["tzname"]}</strong>
timezone. Wind speeds are in mph and temperatures in Fahrenheit.  Values
flagged with a <i>(E)</i> are estimated by the IEM.</p>
  <p>Year: &nbsp; {$ys}
    <p>Month: &nbsp; {$ms}
    <p>&nbsp; <input type='submit' value='Change'></form>
</div>
EOM;
} else {
    $content .= <<<EOM
  <h2>{$nicedate} Summary for {$network}</h2>
  <p>Switch date shown:<br /><input type="hidden" value="daily" name="mode">
  {$ys} {$ms} {$ds}
  <input type="submit" value="Switch Date"></form>
  </div>
<p>This table lists out IEM computed daily summary values. These values are
derived from available observations and specialized summary products that
some observation sites produce. Peak wind timestamps are hopefully in the
local valid time (<strong>{$metadata["tzname"]}</strong>) at the site. There
is a <a href="/request/daily.phtml?network={$network}">download interface</a>
for most of this summary information.</p>
EOM;
}

$content .= $mountpoint;
$t->content = $content;
$t->headextra = <<<EOM
<link rel="stylesheet" href="https://unpkg.com/tabulator-tables@6.3.1/dist/css/tabulator_bootstrap5.min.css" />
EOM;
$t->jsextra = <<<EOM
<script src="https://unpkg.com/tabulator-tables@6.3.1/dist/js/tabulator.min.js"></script>
<script src="hist.module.js?v=2" type="module"></script>
EOM;
$t->render(TEMPLATE);
