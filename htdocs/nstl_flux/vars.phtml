<?php
require_once "../../config/settings.inc.php";
require_once "../../include/forms.php";
require_once "../../include/myview.php";
require_once "../../include/database.inc.php";
$t = new MyView();

$t->title = "NLAE Flux Sites Variables";

$pg_conn = iemdb("other");
$sql = "SELECT * from flux_vars ORDER by name ASC";
$rs = pg_query($pg_conn, $sql);
$rows = "";
for ($i = 0; $row = pg_fetch_assoc($rs); $i++) {
    $rows .= sprintf(
        "<tr><th scope=\"row\">%s</th><td>%s</td><td>%s</td></tr>",
        $row["name"],
        $row["units"],
        $row["details"],
    );
}

$t->content = <<<EOM
<nav aria-label="breadcrumb">
<ol class="breadcrumb mb-3">
 <li class="breadcrumb-item"><a href="/nstl_flux/">NLAE Flux Sites</a></li>
 <li class="breadcrumb-item active" aria-current="page">Data Variables and Units</li>
</ol>
</nav>

<header class="mb-4">
<h1 class="h3">Variables Collected from NLAE Flux Sites</h1>
<p class="mb-0">This page lists variables collected at the four sites in this network. Each variable is not collected at every site.</p>
</header>

<section class="card shadow-sm" aria-labelledby="variables-heading">
<div class="card-header">
<h2 id="variables-heading" class="h5 mb-0">Data variables and units</h2>
</div>
<div class="table-responsive">
<table class="table table-striped table-hover table-sm mb-0">
<caption class="visually-hidden">Variables collected from NLAE flux sites, their units, and details.</caption>
<thead>
<tr>
<th scope="col">ID</th>
<th scope="col">Units</th>
<th scope="col">Details</th>
</tr>
</thead>
<tbody>
{$rows}
</tbody>
</table>
</div>
</section>

EOM;
$t->render('single.phtml');
