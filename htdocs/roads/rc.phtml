<?php
require_once "../../config/settings.inc.php";
define("IEM_APPID", 54);
require_once "../../include/myview.php";
require_once "../../include/database.inc.php";
require_once "../../include/forms.php";
require_once "../../include/mlib.php";

$t = new MyView();

$conn = iemdb("postgis");

$sortcol = isset($_GET["sortcol"]) ? xssafe($_GET["sortcol"]) : "segid";
$t->refresh = 600;

$sql = "SELECT * from roads_current r, roads_base b, roads_conditions c " .
    "WHERE r.segid = b.segid and r.cond_code = c.code";
$rs = pg_query($conn, $sql);

$obs = array();
while ($row = pg_fetch_assoc($rs)) {
    $seg = intval($row["segid"]);
    $obs[$seg] = $row;
    $t2 = preg_split('/ to /', $row["longname"]);
    if (sizeof($t2) == 2) {
        $obs[$seg]["minor0"] = $t2[0];
        $obs[$seg]["minor1"] = $t2[1];
    } else {
        $obs[$seg]["minor0"] = $t2[0];
        $obs[$seg]["minor1"] = '';
    }

    if ($row["type"] == 1) {
        $obs[$seg]["number"] = intval($row["int1"]);
    }
    if ($row["type"] == 2) {
        $obs[$seg]["number"] = intval($row["us1"]);
    }
    if ($row["type"] == 3) {
        $obs[$seg]["number"] = intval($row["st1"]);
    }
    $valid = substr($row["valid"], 0, 16);
}
if (!isset($valid)) {
    $valid = "";
}
$ts = strtotime($valid);
$valid = date("h:i A d M Y", $ts);

$types = array(1 => "Interstate", 2 => "US Highway", 3 => "State Highway");

$vals = array(
    "number" => "Route #", "type" => "Road Classification",
    "minor0" => "Start Point", "minor1" => "End Point",
    "label" => "Road Condition", "cond_code" => "Road Condition",
    "segid" => "Travel Path"
);

$uri = "rc.phtml?sortcol=";

$finalA = aSortBySecondIndex($obs, $sortcol);
$now = time();
$i = 0;
$table = "";
foreach ($finalA as $key => $val) {
    $i++;
    $parts = $finalA[$key];

        $table .= "<tr>";
        $table .= "<td>" . $types[$parts["type"]] . "</td>";
        $table .= "<td class=\"text-nowrap\">" . $parts["number"] . "</td>";
        $table .= "<td>" . $parts["minor0"] . " <span class=\"text-body-secondary\">to</span> " . $parts["minor1"] . "</td>";
        $table .= "<td>" . $parts["raw"] . "</td>";
        $table .= "</tr>";
}

$t->content = <<<EOM
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/roads/">Roads</a></li>
        <li class="breadcrumb-item active" aria-current="page">Sortable Conditions</li>
    </ol>
</nav>

<div class="d-flex flex-wrap justify-content-between align-items-baseline gap-2 mb-3">
    <h1 class="h3 mb-0">Iowa Road Conditions</h1>
    <span class="text-body-secondary">Valid {$valid}</span>
</div>

<div class="alert alert-info d-flex align-items-start gap-2 mb-3" role="note">
    <i class="bi bi-info-circle-fill flex-shrink-0" aria-hidden="true"></i>
    <div>
        Sorted by <strong>{$vals[$sortcol]}</strong>. Select a column heading to change the sort order,
        or <a href="{$uri}segid" class="alert-link">sort by travel path</a>.
    </div>
</div>

<table class="table table-striped table-hover align-middle mb-0">
    <caption class="caption-top">Current road conditions by segment</caption>
    <thead class="table-dark sticky">
        <tr>
            <th scope="col"><a class="link-light" href="{$uri}type">Road Class</a></th>
            <th scope="col"><a class="link-light" href="{$uri}number">Route #</a></th>
            <th scope="col"><a class="link-light" href="{$uri}minor0">Segment</a></th>
            <th scope="col"><a class="link-light" href="{$uri}cond_code">Condition</a></th>
        </tr>
    </thead>
    <tbody>
        {$table}
    </tbody>
</table>
EOM;
$t->render('single.phtml');
